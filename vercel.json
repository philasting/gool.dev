{
  "functions": {
    "src/app/api/trending/**": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/trending/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" }
      ]
    }
  ]
}
